# Identidade pública
NEXT_PUBLIC_SITE_NAME=NEXUS BRASIL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase — use a chave publicável do painel Connect
NEXT_PUBLIC_SUPABASE_URL=
# Recomendado para projetos novos
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Compatibilidade com projetos antigos; não é necessária se a publicável estiver definida
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Apenas para rotas administrativas no servidor; o login não usa esta chave
SUPABASE_SERVICE_ROLE_KEY=

# Inteligência artificial — nunca exponha esta chave no navegador
AI_API_URL=
AI_API_KEY=
AI_MODEL=

# Mercado Pago — use credenciais TEST durante o desenvolvimento
MERCADO_PAGO_ACCESS_TOKEN=
NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_WEBHOOK_SECRET=

# Analytics
NEXT_PUBLIC_GA_ID=

# Segurança e limites
APP_SECRET=
AI_FREE_DAILY_LIMIT=10
MARKETPLACE_COMMISSION_PERCENT=8
